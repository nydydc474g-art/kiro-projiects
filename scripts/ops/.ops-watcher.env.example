# Copy to ~/ai_sandbox/.ops-watcher.env, fill in real values, then:
#   chmod 600 ~/ai_sandbox/.ops-watcher.env
#
# watcher 启动时会校验 perms == 600；权限不对则 TELEGRAM_DISABLED=1（watcher 仍跑，
# 只是不发 Telegram，并写一条 events.jsonl warning）。
#
# 这个文件独立于 docker-compose 的 .env：watcher 是宿主机进程，只需要 Telegram 两
# 个变量（+ 可选代理），不需要 LLM key / 搜索 key / HOST_UID 等。最小授权原则。

TELEGRAM_BOT_TOKEN=000000000:replace_with_real_token
TELEGRAM_CHAT_ID=000000000

# 可选：Telegram sendMessage 走本地代理。空 = 直连 api.telegram.org
#
# 何时需要：宿主机直连 api.telegram.org 不通时（典型场景：GFW 对 telegram 域名
# 做 SNI 阻断；或宿主机出口受限需要走 SR/ClashX/Surge 这类工具）。
#
# 设计意图：watcher 只把这条代理用于 Telegram sendMessage 一处，不影响其他 curl
# （未来 Phase 4 docker compose 等不会被绑架）。所以**不要**用 HTTPS_PROXY，
# 用专用 TELEGRAM_PROXY_URL。watcher 启动时主动 unset HTTPS_PROXY/HTTP_PROXY/
# ALL_PROXY 以避免历史 env 文件污染。
#
# 现实约束：依赖本地代理时，若 watcher 由 launchd 自启而代理客户端尚未起来，
# started 通知可能发不出（watcher 主流程不受影响）。这是天然代价，不是 bug。
# 修复方案：B.4 launchd plist 加启动顺序约束 + heartbeat 心跳作为侧面信号。
#
# TELEGRAM_PROXY_URL=http://127.0.0.1:1082
TELEGRAM_PROXY_URL=
